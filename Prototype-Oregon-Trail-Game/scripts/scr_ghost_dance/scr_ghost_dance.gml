function scr_ghost_dance_option_1(){
	scr_reset_outcomes();
	scr_increment_culture(20);
	scr_increment_aggression(5);
}

function scr_ghost_dance_option_2(){
	scr_reset_outcomes();
	scr_increment_culture(-10);
}